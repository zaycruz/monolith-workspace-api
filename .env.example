# monolith-workspace-api — Environment Configuration
# Copy to .env and fill in values. Never commit .env itself.

# Server
HOST=0.0.0.0
PORT=8500
BASE_URL=http://localhost:8500

# Postgres / Supabase
# For Supabase: postgresql://postgres:<pw>@<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/workspace

# Supabase service-role (only used if Supabase features are enabled)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk (human auth)
# When VERIFY_CLERK=false, the service accepts any bearer that parses as a Clerk
# JWT envelope without cryptographic verification (DEV ONLY). Production must
# set VERIFY_CLERK=true and provide CLERK_JWKS_URL + CLERK_ISSUER.
VERIFY_CLERK=false
CLERK_SECRET_KEY=
CLERK_JWKS_URL=
CLERK_ISSUER=

# Machine-token signing (future: HMAC-verify the tokens; for MVP we only
# sha256-hash and look them up in agent_machine_tokens).
WORKSPACE_MACHINE_TOKEN_SIGNING_KEY=change-me

# Feature flags
AUTH_ENABLED=true

# Realtime
SSE_HEARTBEAT_SECONDS=15
